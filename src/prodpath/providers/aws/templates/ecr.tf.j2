{% for s in services %}
resource "aws_ecr_repository" "{{ s.tf }}" {
  name                 = "${local.name}/{{ s.id }}"
  image_tag_mutability = "IMMUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }

  encryption_configuration {
    encryption_type = "AES256"
  }
}

resource "aws_ecr_lifecycle_policy" "{{ s.tf }}" {
  repository = aws_ecr_repository.{{ s.tf }}.name

  policy = jsonencode({
    rules = [
      {
        rulePriority = 1
        description  = "Keep the 20 most recent images"
        selection = {
          tagStatus   = "any"
          countType   = "imageCountMoreThan"
          countNumber = 20
        }
        action = {
          type = "expire"
        }
      }
    ]
  })
}

{% endfor %}
