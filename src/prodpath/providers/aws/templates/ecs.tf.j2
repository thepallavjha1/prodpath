{% if has_cluster %}
resource "aws_ecs_cluster" "main" {
  name = local.name

  setting {
    name  = "containerInsights"
    value = "enabled"
  }
}

{% endif %}
{% for s in services %}
# ---- {{ s.id }} ({{ s.kind }}) ----
{% if s.env_names %}
# Non-secret variables found in the code (set their values in var.service_environment["{{ s.id }}"]):
# {{ s.env_names | join(", ") }}
{% endif %}
{% if s.port_assumed %}
# The listening port was not found in the code; {{ s.port }} is an assumption. Fix it here and in the Dockerfile.
{% endif %}
resource "aws_cloudwatch_log_group" "{{ s.tf }}" {
  name              = "/${var.app_name}/${var.environment}/{{ s.id }}"
  retention_in_days = var.log_retention_days
}

resource "aws_security_group" "{{ s.tf }}" {
  name        = "${local.name}-{{ s.id }}"
  description = "Tasks of {{ s.id }}"
  vpc_id      = aws_vpc.main.id
{% if s.kind == "web" %}

  ingress {
    description     = "Traffic from the load balancer only"
    from_port       = {{ s.port }}
    to_port         = {{ s.port }}
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
  }
{% endif %}

  # Egress is open; reachability is limited by routing (VPC endpoints, optional NAT).
  egress {
    description = "Outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_ecs_task_definition" "{{ s.tf }}" {
  family                   = "${local.name}-{{ s.id }}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.service_sizing["{{ s.id }}"].cpu
  memory                   = var.service_sizing["{{ s.id }}"].memory
  execution_role_arn       = aws_iam_role.{{ s.tf }}_execution.arn
  task_role_arn            = aws_iam_role.{{ s.tf }}_task.arn

  container_definitions = jsonencode([
    {
      name      = "{{ s.id }}"
      image     = "${aws_ecr_repository.{{ s.tf }}.repository_url}:${var.image_tags["{{ s.id }}"]}"
      essential = true
{% if s.kind == "web" %}
      portMappings = [
        {
          containerPort = {{ s.port }}
          protocol      = "tcp"
        }
      ]
{% endif %}
      environment = [
        for key, value in lookup(var.service_environment, "{{ s.id }}", {}) : {
          name  = key
          value = value
        }
      ]
      secrets = [
{% for secret in s.secrets %}
        {
          name      = "{{ secret.name }}"
          valueFrom = aws_secretsmanager_secret.{{ secret.tf }}.arn
        },
{% endfor %}
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.{{ s.tf }}.name
          "awslogs-region"        = var.region
          "awslogs-stream-prefix" = "ecs"
        }
      }
    }
  ])
}
{% if s.kind != "cron" %}

resource "aws_ecs_service" "{{ s.tf }}" {
  name            = "{{ s.id }}"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.{{ s.tf }}.arn
  desired_count   = var.service_sizing["{{ s.id }}"].desired_count
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = aws_subnet.private[*].id
    security_groups  = [aws_security_group.{{ s.tf }}.id]
    assign_public_ip = false
  }
{% if s.kind == "web" %}

  load_balancer {
    target_group_arn = aws_lb_target_group.{{ s.tf }}.arn
    container_name   = "{{ s.id }}"
    container_port   = {{ s.port }}
  }
{% endif %}

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }
{% if s.kind == "web" %}

  depends_on = [aws_lb_listener.https]
{% endif %}

  # CI deploys new task definition revisions and autoscaling owns the task count: Terraform
  # must not roll either back.
  lifecycle {
    ignore_changes = [task_definition, desired_count]
  }
}
{% endif %}

{% endfor %}
