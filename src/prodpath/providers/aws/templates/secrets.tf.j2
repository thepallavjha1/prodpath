{% for s in services %}
{% for secret in s.secrets %}
# Created empty on purpose: set the value yourself, out of band. Terraform never sees it.
resource "aws_secretsmanager_secret" "{{ secret.tf }}" {
  name                    = "${var.environment}/{{ s.id }}/{{ secret.name }}"
  description             = "{{ secret.name }} for {{ s.id }}. Value is set outside Terraform."
  recovery_window_in_days = {{ 30 if is_prod else 7 }}
}

{% endfor %}
{% endfor %}
