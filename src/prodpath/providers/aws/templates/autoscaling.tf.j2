{% for s in scaling %}
resource "aws_appautoscaling_target" "{{ s.tf }}" {
  max_capacity       = var.service_scaling["{{ s.id }}"].max_count
  min_capacity       = var.service_scaling["{{ s.id }}"].min_count
  resource_id        = "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.{{ s.tf }}.name}"
  scalable_dimension = "ecs:service:DesiredCount"
  service_namespace  = "ecs"
}

resource "aws_appautoscaling_policy" "{{ s.tf }}_cpu" {
  name               = "${local.name}-{{ s.id }}-cpu"
  policy_type        = "TargetTrackingScaling"
  resource_id        = aws_appautoscaling_target.{{ s.tf }}.resource_id
  scalable_dimension = aws_appautoscaling_target.{{ s.tf }}.scalable_dimension
  service_namespace  = aws_appautoscaling_target.{{ s.tf }}.service_namespace

  target_tracking_scaling_policy_configuration {
    target_value       = var.service_scaling["{{ s.id }}"].cpu_target
    scale_out_cooldown = 60
    scale_in_cooldown  = 300

    predefined_metric_specification {
      predefined_metric_type = "ECSServiceAverageCPUUtilization"
    }
  }
}

{% endfor %}
