{% if has_alb %}
# The only security group open to the internet, and only on 80 and 443.
resource "aws_security_group" "alb" {
  name        = "${local.name}-alb"
  description = "Public HTTP and HTTPS entry point"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "HTTPS from anywhere"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP from anywhere (redirected to HTTPS)"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "Forward to targets inside the VPC"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = [aws_vpc.main.cidr_block]
  }
}

resource "aws_lb" "main" {
  name                       = substr("${local.name}-alb", 0, 32)
  load_balancer_type         = "application"
  internal                   = false
  security_groups            = [aws_security_group.alb.id]
  subnets                    = aws_subnet.public[*].id
  drop_invalid_header_fields = true
  enable_deletion_protection = {{ "true" if is_prod else "false" }}
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.main.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.certificate_arn

  default_action {
    type = "fixed-response"

    fixed_response {
      content_type = "text/plain"
      message_body = "Not found"
      status_code  = "404"
    }
  }
}

resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"

    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}
{% for s in web_services %}

{% if s.health_assumed %}
# No health endpoint was found for {{ s.id }}; "/" is an assumption. Point it at a real health check.
{% endif %}
resource "aws_lb_target_group" "{{ s.tf }}" {
  name_prefix          = "{{ s.tg_prefix }}"
  port                 = {{ s.port }}
  protocol             = "HTTP"
  target_type          = "ip"
  vpc_id               = aws_vpc.main.id
  deregistration_delay = 30

  health_check {
    path    = "{{ s.health }}"
    matcher = "200-399"
  }
{% if s.sticky %}

  # Each visitor's session lives in one task, so keep a visitor on the same task.
  stickiness {
    type            = "lb_cookie"
    cookie_duration = 86400
    enabled         = true
  }
{% endif %}

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_lb_listener_rule" "{{ s.tf }}" {
  listener_arn = aws_lb_listener.https.arn
  priority     = {{ 100 + loop.index0 }}

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.{{ s.tf }}.arn
  }

  condition {
    host_header {
      values = ["{{ s.id }}.${var.domain_name}"]
    }
  }
}
{% endfor %}
{% endif %}
