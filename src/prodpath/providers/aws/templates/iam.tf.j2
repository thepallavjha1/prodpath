{% if services %}
data "aws_iam_policy_document" "ecs_tasks_assume" {
  statement {
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }
  }
}

{% endif %}
{% for s in services %}
# {{ s.id }}: the execution role pulls the image, writes logs and reads this service's secrets.
resource "aws_iam_role" "{{ s.tf }}_execution" {
  name               = "${local.name}-{{ s.id }}-exec"
  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
}

resource "aws_iam_role_policy_attachment" "{{ s.tf }}_execution" {
  role       = aws_iam_role.{{ s.tf }}_execution.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}
{% if s.secrets %}

resource "aws_iam_role_policy" "{{ s.tf }}_execution_secrets" {
  name = "read-own-secrets"
  role = aws_iam_role.{{ s.tf }}_execution.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = ["secretsmanager:GetSecretValue"]
        Resource = [
{% for secret in s.secrets %}
          aws_secretsmanager_secret.{{ secret.tf }}.arn,
{% endfor %}
        ]
      }
    ]
  })
}
{% endif %}

# The task role is what the application code runs as: only the resources it was found using.
resource "aws_iam_role" "{{ s.tf }}_task" {
  name               = "${local.name}-{{ s.id }}-task"
  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
}
{% if s.buckets or s.uses_sqs or s.uses_sns %}

resource "aws_iam_role_policy" "{{ s.tf }}_task" {
  name = "app-access"
  role = aws_iam_role.{{ s.tf }}_task.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
{% for bucket in s.buckets %}
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
        Resource = ["${aws_s3_bucket.{{ bucket }}.arn}/*"]
      },
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = [aws_s3_bucket.{{ bucket }}.arn]
      },
{% endfor %}
{% if s.uses_sqs %}
      {
        Effect   = "Allow"
        Action   = ["sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
        Resource = [aws_sqs_queue.main.arn]
      },
{% endif %}
{% if s.uses_sns %}
      {
        Effect   = "Allow"
        Action   = ["sns:Publish"]
        Resource = [aws_sns_topic.main.arn]
      },
{% endif %}
    ]
  })
}
{% endif %}

{% endfor %}
